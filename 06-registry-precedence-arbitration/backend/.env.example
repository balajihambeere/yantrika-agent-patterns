# Your OpenAI API key — enables /api/chat (never hardcode this). Without it,
# /api/chat degrades gracefully and says so instead of failing.
OPENAI_API_KEY=sk-...
# Chat model used for the LLM-backed /api/chat path; defaults to gpt-4o-mini if unset.
OPENAI_MODEL=gpt-4o-mini
# Comma-separated list of origins allowed to call this API (CORS).
CORS_ORIGINS=http://localhost:3000
