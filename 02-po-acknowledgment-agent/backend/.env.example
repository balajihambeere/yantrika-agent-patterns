# Your OpenAI API key — powers /api/chat's free-text answers. Never hardcode
# this. If unset, /api/chat degrades gracefully and answers from context only.
OPENAI_API_KEY=sk-...
# Chat model used by /api/chat when OPENAI_API_KEY is set; defaults to
# gpt-4o-mini if unset.
OPENAI_MODEL=gpt-4o-mini
# Comma-separated list of allowed CORS origins for the frontend.
CORS_ORIGINS=http://localhost:3000
